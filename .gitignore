checkpoints/*
!checkpoints/.gitkeep
*.ckpt
*.ckpt.*
*.keras
*.weights.h5

# Experiment logs and generated figures
results/logs/*
!results/logs/.gitkeep
results/figures/*
!results/figures/.gitkeep
*.log
*.tfevents.*

